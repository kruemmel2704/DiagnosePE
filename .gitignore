# --- DiagnosePE WinPE build artifacts ---
# Arbeits- und Ausgabeverzeichnisse des Build-Prozesses
/work/
/out/
*.iso
*.wim
*.log

# Heruntergeladene / entpackte Treiber (zu groß fürs Repo).
# Es bleiben nur die README-/.gitkeep-Platzhalter erhalten.
/drivers/**/*
!/drivers/**/
!/drivers/**/README.md
!/drivers/**/.gitkeep

# Heruntergeladene DiagnoseTool-Binaries / FurMark
/app/
*.exe
*.zip
*.7z

# OS-Müll
.DS_Store
Thumbs.db
